+#ifdef USE_ASCEND_DIRECT
+void TransferEnginePy::acquireAscendWrites() {
+    pybind11::gil_scoped_release release;
+    // Called only after successful synchronous READ or peer WRITE completion.
+    // This barrier orders subsequent local device consumers; it does not cancel
+    // or establish completion of an unknown remote transfer.
+    auto status = aclrtSynchronizeDevice();
+    if (status != ACL_ERROR_NONE) {
+        throw std::runtime_error("Ascend device acquire failed");
+    }
+}
+
+int TransferEnginePy::invalidateDrainedAscendSegment(const std::string& segment_name) {
+    pybind11::gil_scoped_release release;
+    if (configured_backend_ != "ascend_direct") return -1;
+    {
+        std::lock_guard<std::mutex> guard(mutex_);
+        handle_map_.erase(segment_name);
+    }
+    // Caller gates all sessions and drains transfers before deregistration.
+    // Evict the TE descriptor only. Existing ADXL links are not reusable across
+    // process generations; EK tombstones the endpoint until runtime restart.
+    return engine_->removeLocalSegment(segment_name);
+}
+#endif

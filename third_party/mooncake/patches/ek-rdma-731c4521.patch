+    auto rdma = std::make_shared<BatchResultTransport>();
+    auto tcp = std::make_shared<BatchResultTransport>();
+
+    TransferEngineImplTestPeer::replaceTransports(engine, {{"rdma", rdma}});
+    EXPECT_TRUE(engine.isTransportOnly("rdma"));
+    EXPECT_FALSE(engine.isTransportOnly("tcp"));
+
+    TransferEngineImplTestPeer::replaceTransports(
+        engine, {{"rdma", rdma}, {"tcp", tcp}});
+    EXPECT_FALSE(engine.isTransportOnly("rdma"));
+    EXPECT_FALSE(engine.isTransportOnly("tcp"));

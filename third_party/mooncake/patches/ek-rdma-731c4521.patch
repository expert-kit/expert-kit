+int TransferEnginePy::invalidateDrainedRdmaSegment(
+    const std::string& segment_name) {
+    pybind11::gil_scoped_release release;
+    {
+        std::lock_guard<std::mutex> guard(mutex_);
+        auto handle = handle_map_.find(segment_name);
+        if (handle != handle_map_.end()) {
+            handle_map_.erase(handle);
+        }
+    }
+    // The caller owns the target-wide gate and has synchronously drained DMA.
+    // RDMA endpoints/QPs may be shared by other remote targets, so graceful
+    // close evicts only this process's cached remote descriptor.
+    return engine_->removeLocalSegment(segment_name);
+}

+int TransferEngineImpl::invalidateLocalSegment(
+    const std::string& segment_name,
+    Transport::SegmentHandle expected_handle) {
+    if (segment_name.empty()) return ERR_INVALID_ARGUMENT;
+    std::string trimmed_segment_name = segment_name;
+    while (!trimmed_segment_name.empty() && trimmed_segment_name[0] == '/')
+        trimmed_segment_name.erase(0, 1);
+    if (trimmed_segment_name.empty()) return ERR_INVALID_ARGUMENT;
+
+    const SegmentID missing_handle = (SegmentID)-1;
+    SegmentID cached_handle =
+        metadata_->getCachedSegmentID(trimmed_segment_name);
+    std::vector<SegmentID> handles_to_invalidate;
+    if (cached_handle != missing_handle) {
+        handles_to_invalidate.push_back(cached_handle);
+    }
+    if (expected_handle != (Transport::SegmentHandle)-1 &&
+        expected_handle != cached_handle) {
+        handles_to_invalidate.push_back(expected_handle);
+    }
+    if (handles_to_invalidate.empty()) return 0;
+
+    for (SegmentID handle : handles_to_invalidate) {
+        if (handle == LOCAL_SEGMENT_ID) {
+            LOG(ERROR) << "Refusing to invalidate the local segment "
+                       << trimmed_segment_name;
+            return ERR_INVALID_ARGUMENT;
+        }
+        int ret = multi_transports_->invalidateRemoteSegment(handle);
+        if (ret != 0) {
+            LOG(ERROR) << "Failed to invalidate transport state for segment "
+                       << trimmed_segment_name << " (#" << handle
+                       << "); retaining the local descriptor cache";
+            return ret;
+        }
+    }
+
+    // This is deliberately local-only. removeSegmentDesc() may delete the
+    // remote owner's authoritative etcd/Redis metadata and must not be used
+    // for client-side generation invalidation.
+    return metadata_->removeLocalSegment(trimmed_segment_name);
+}

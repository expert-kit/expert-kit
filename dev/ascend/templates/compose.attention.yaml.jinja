name: {{ project_name }}

x-model-mount: &model-mount
  type: bind
  source: {{ model.path }}
  target: /model/{{ model.name }}
  read_only: true

services:
  postgres:
    image: {{ images.postgres }}
    pull_policy: missing
    environment:
      POSTGRES_USER: {{ control.database.user }}
      POSTGRES_PASSWORD: {{ control.database.password }}
      POSTGRES_DB: {{ control.database.name }}
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "{{ control.database.user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped
    volumes:
      - pg-data:/var/lib/postgresql/data
    networks:
      - expert-kit-network

  migrations:
    image: {{ images.control }}
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ./controller.yaml:/etc/expert-kit/config.yaml:ro
    command:
      - ek-cli
      - db
      - migrate
    networks:
      - expert-kit-network

  weight-server:
    image: {{ images.control }}
    depends_on:
      migrations:
        condition: service_completed_successfully
    restart: unless-stopped 
    volumes:
      - *model-mount
      - ./controller.yaml:/etc/expert-kit/config.yaml:ro
      - weight-cache:/var/cache/expert-kit/weight-cache
    environment:
      RUST_LOG: info
    command: 
      - ek-cli
      - weight-server
      - --model
      - /model/{{ model.name }}
    networks:
      - expert-kit-network

  model-init:
    image: {{ images.control }}
    depends_on:
      migrations:
        condition: service_completed_successfully
      weight-server:
        condition: service_started
    volumes:
      - ./controller.yaml:/etc/expert-kit/config.yaml:ro
    environment:
      RUST_LOG: info
    networks:
      - expert-kit-network
    command: 
        - ek-cli 
        - model 
        - upsert
        - --name
        - {{ model.name }}

  controller:
    image: {{ images.control }}
    depends_on:
      migrations:
        condition: service_completed_successfully
      model-init:
        condition: service_completed_successfully
    restart: unless-stopped 
    volumes:
      - ./controller.yaml:/etc/expert-kit/config.yaml:ro
    environment:
      RUST_LOG: info
    command: 
      - ek-cli
      - controller
    networks:
      - expert-kit-network

  admin:
    image: {{ images.control }}
    profiles: ["tools"]
    volumes:
      - ./controller.yaml:/etc/expert-kit/config.yaml:ro
      - weight-cache:/var/cache/expert-kit/weight-cache
    networks:
      - expert-kit-network

  attention:
    image: {{ images.attention }}
    privileged: true
    ipc: host
    shm_size: 16g
    depends_on:
      controller:
        condition: service_started
    healthcheck:
      test:
        - CMD
        - python3
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2)"
      interval: 10s
      timeout: 3s
      retries: 12
      start_period: 10m
    volumes:
      - *model-mount
      - ./vllm-serve.yaml:/configs/vllm-serve.yaml:ro
      - /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro
      - /usr/local/Ascend/firmware:/usr/local/Ascend/firmware:ro
      - /etc/ascend_install.info:/etc/ascend_install.info:ro
      - /usr/local/bin/npu-smi:/usr/local/bin/npu-smi:ro
      - /usr/local/dcmi:/usr/local/dcmi:ro
      - /dev/devmm_svm:/dev/devmm_svm
    entrypoint: ["vllm"]
    command:
      - serve
      - --config
      - /configs/vllm-serve.yaml
    environment:
      EK_ENABLE: "1"
      EK_ADDR: controller:5002
      ASCEND_RT_VISIBLE_DEVICES: {{ attention.visible_devices }}
    networks:
      - expert-kit-network

  benchmark:
    image: {{ images.attention }}
    depends_on:
      attention:
        condition: service_healthy
    volumes:
      - *model-mount
{% if dataset.type != "random" %}
      - {{ dataset.path }}:{{ dataset.mounted_path }}:ro
{% endif %}
      - ./vllm-bench.yaml:/configs/vllm-bench.yaml:ro
      - /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro
      - /usr/local/Ascend/firmware:/usr/local/Ascend/firmware:ro
      - /etc/ascend_install.info:/etc/ascend_install.info:ro
      - /usr/local/bin/npu-smi:/usr/local/bin/npu-smi:ro
      - /usr/local/dcmi:/usr/local/dcmi:ro
      - /dev/devmm_svm:/dev/devmm_svm
      - type: bind
        source: {{ results_path }}
        target: /results
      - ../bench_launcher.py:/bench_launcher.py:ro
    entrypoint: ["python3"]
    command:
      - /bench_launcher.py
      - --config
      - /configs/vllm-bench.yaml
    environment:
      EK_ENABLE: "0"
      TORCH_DEVICE_BACKEND_AUTOLOAD: "0"
      VLLM_PLUGINS: ""
    networks:
      - expert-kit-network

networks:
  expert-kit-network:
    driver: bridge

volumes:
  pg-data:
  weight-cache:

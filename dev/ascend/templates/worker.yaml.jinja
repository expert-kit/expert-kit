model:
  name: {{ model.name }}
  weight_version: {{ model.weight_version }}
  num_layers: {{ model.num_layers }}
  experts_per_layer: {{ model.experts_per_layer }}
  hidden_dim: {{ model.hidden_dim }}
  expert_intermediate_dim: {{ model.intermediate_dim }}
  top_k: {{ model.topk }}
  activation_dtype: {{ model.dtype }}
  weight_dtype: {{ model.dtype }}

worker:
  id: {{ worker.id }}
  backend: torch
  device: {{ worker.device_name }}
  max_batch_tokens: {{ expert.workers.runtime.max_batch_tokens }}
  max_active_batches_per_device: {{ expert.workers.runtime.max_active_batches_per_device }}
  device_memory_limit: {{ expert.workers.runtime.device_memory_limit }}
  shutdown_grace_secs: {{ expert.workers.runtime.shutdown_grace_secs }}

transport:
  type: grpc
  max_pending_batches_per_device: {{ expert.workers.runtime.max_pending_batches_per_device }}
  listen: 0.0.0.0:51234
  advertise: {{ expert.address }}:{{ worker.port }}

controller:
  endpoint: {{ control.address }}:{{ control.worker_control_port }}
  heartbeat_interval_secs: {{ expert.workers.runtime.heartbeat_interval_secs }}
  heartbeat_timeout_secs: {{ expert.workers.runtime.heartbeat_timeout_secs }}

weight_manager:
  max_concurrent_loads: {{ expert.workers.runtime.max_concurrent_loads }}
  disk_cache:
    path: /ek/worker_cache/{{ worker.id }}
    writeback: true
  peer:
    listen: 0.0.0.0:52234
    advertise: http://{{ expert.address }}:{{ worker.peer_port }}
  weight_server_endpoint: http://{{ control.address }}:{{ control.weight_server_port }}

logging:
  level: INFO
  format: console

observability:
  prometheus:
    enabled: false
  tracing:
    enabled: false

name: {{ project_name }}-{{ pool.id }}

services:
{% for worker in pool.workers %}
  {{ worker.id }}:
    image: {{ images.expert }}
    entrypoint:
      - uv
      - run
      - --no-sync
      - --package
      - expertkit-worker
      - ek-worker
    command: ["--config", "/etc/expert-kit/worker.yaml"]
    privileged: true
    ipc: host
    restart: unless-stopped
    stop_grace_period: 60s
    volumes:
      - ./workers/{{ worker.id }}.yaml:/etc/expert-kit/worker.yaml:ro
      - worker-cache:/ek/worker_cache
      - /usr/local/Ascend/driver:/usr/local/Ascend/driver:ro
      - /usr/local/Ascend/firmware:/usr/local/Ascend/firmware:ro
      - /etc/ascend_install.info:/etc/ascend_install.info:ro
      - /usr/local/bin/npu-smi:/usr/local/bin/npu-smi:ro
      - /usr/local/dcmi:/usr/local/dcmi:ro
      - /dev/devmm_svm:/dev/devmm_svm
{% if transport.type == "transfer_engine" %}
      - /etc/hccn.conf:/etc/hccn.conf:ro
{% endif %}
    environment:
      RUST_LOG: info
{% if transport.type == "transfer_engine" %}
      ASCEND_USE_ASYNC_TRANSFER: "0"
      ASCEND_BUFFER_POOL: "0:0"
      ASCEND_USE_SHORT_CONNECTION: "0"
    network_mode: host
{% else %}
    networks:
      - expert-kit-network
{% endif %}
{% endfor %}

networks:
  expert-kit-network:
    driver: bridge

volumes:
  worker-cache:

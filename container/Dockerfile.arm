FROM openeuler/openeuler:22.03-lts-sp4 AS rust-base

ARG PROXY
ENV HTTP_PROXY=${PROXY}
ENV HTTPS_PROXY=${PROXY}
ENV NO_PROXY=localhost,127.0.0.1
ENV PATH="/root/.cargo/bin:${PATH}"

RUN dnf install -y \
    curl \
    gcc \
    gcc-c++ \
    git \
    libpq-devel \
    make \
    openssl-devel \
    pkg-config \
    && dnf clean all

FROM rust-base AS ek-rust-build

WORKDIR /app
COPY rust-toolchain.toml ./
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain none \
    && rustup show

RUN cargo install diesel_cli --no-default-features --features postgres

COPY Cargo.toml Cargo.lock ./
COPY ek-base/ ./ek-base/
COPY ek-cli/ ./ek-cli/
COPY ek-computation/ ./ek-computation/
COPY ek-db/ ./ek-db/
COPY ek-proto/ ./ek-proto/
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release --locked -p ek-cli \
    && cp /app/target/release/ek-cli /tmp/ek-cli

FROM openeuler/openeuler:22.03-lts-sp4 AS ek-runtime

RUN dnf install -y ca-certificates libpq && dnf clean all

WORKDIR /ek
COPY --from=ek-rust-build /root/.cargo/bin/diesel /usr/local/bin/
COPY --from=ek-rust-build /tmp/ek-cli /usr/local/bin/

RUN mkdir -p /etc/expert-kit && cat > /etc/expert-kit/config.yaml <<'EOF'
inference:
  instance_name: qwen3_moe_30b_local_test
  model_name: qwen3
  hidden_dim: 2048
  intermediate_dim: 768

db:
  db_dsn: postgres://dev:dev@localhost:5432/dev
  max_conn_size: 32

weight:
  server:
    addr: http://localhost:6543
  cache:
    Fs:
      path: /ek/weight_cache

controller:
  listen: 0.0.0.0
  broadcast: localhost
  ports:
    intra: 5001
    inter: 5002
EOF

ENTRYPOINT [""]

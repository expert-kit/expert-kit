ARG RUST_IMAGE=rust:1.88.0
FROM ${RUST_IMAGE} AS rust-base

ARG PROXY
ENV HTTP_PROXY=${PROXY}
ENV HTTPS_PROXY=${PROXY}
ENV NO_PROXY=localhost,127.0.0.1
ENV CARGO_HOME=/root/.cargo

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    libpq-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

FROM rust-base AS ek-rust-build

WORKDIR /app
RUN rustc --version && cargo --version

COPY Cargo.toml Cargo.lock ./
COPY ek-base/ ./ek-base/
COPY ek-cli/ ./ek-cli/
COPY ek-computation/ ./ek-computation/
COPY ek-db/ ./ek-db/
COPY ek-proto/ ./ek-proto/
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release --locked -p ek-cli \
    && cp /app/target/release/ek-cli /tmp/ek-cli

FROM rust-base AS ek-diesel-build

RUN cargo install diesel_cli --version 2.2.12 --locked \
    --no-default-features --features postgres

FROM ubuntu:24.04 AS ek-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ek
COPY --from=ek-diesel-build /root/.cargo/bin/diesel /usr/local/bin/
COPY --from=ek-rust-build /tmp/ek-cli /usr/local/bin/

RUN mkdir -p /etc/expert-kit && cat > /etc/expert-kit/config.yaml <<'EOF'
inference:
  instance_name: qwen3_moe_30b_local_test
  model_name: qwen3
  hidden_dim: 2048
  intermediate_dim: 768

db:
  db_dsn: postgres://dev:dev@localhost:5432/dev
  max_conn_size: 32

weight:
  server:
    addr: http://localhost:6543
  cache:
    Fs:
      path: /ek/weight_cache

controller:
  listen: 0.0.0.0
  broadcast: localhost
  ports:
    intra: 5001
    inter: 5002
EOF

ENTRYPOINT [""]

FROM ubuntu:24.04 AS ek-worker-cuda-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libpq5 \
    python3.12 \
    python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.6.9 /uv /uvx /usr/local/bin/
COPY --from=ek-rust-build /tmp/ek-cli /usr/local/bin/
COPY ek-transport/ /opt/expert-kit/ek-transport/
COPY ek-worker/ /opt/expert-kit/ek-worker/

ARG UV_HTTP_TIMEOUT=300
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_HTTP_TIMEOUT=${UV_HTTP_TIMEOUT} \
    UV_LINK_MODE=copy \
    uv sync --project /opt/expert-kit/ek-worker --locked --no-dev

ENV PATH="/opt/expert-kit/ek-worker/.venv/bin:${PATH}"
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /opt/expert-kit
ENTRYPOINT [""]

ARG RUST_IMAGE="rust:1.88.0-bookworm"
ARG RUNTIME_IMAGE="debian:bookworm-slim"
ARG UV_IMAGE="ghcr.io/astral-sh/uv:0.11.30"

FROM ${RUST_IMAGE} AS rust-base

ENV CARGO_HOME=/root/.cargo

# Replace official Debian APT sources with TUNA mirrors.
RUN sed -i \
        -e 's@//deb.debian.org@//mirrors.tuna.tsinghua.edu.cn@g' \
        -e 's@//security.debian.org@//mirrors.tuna.tsinghua.edu.cn@g' \
        /etc/apt/sources.list.d/debian.sources

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    libpq-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Overwrites cargo crate.io source, accelarating cargo build & cargo install
COPY container/cargo-config.cn.toml /root/.cargo/config.toml

FROM rust-base AS ek-rust-build

WORKDIR /app
RUN rustc --version && cargo --version

COPY Cargo.toml Cargo.lock ./
COPY ek-base/ ./ek-base/
COPY ek-cli/ ./ek-cli/
COPY ek-computation/ ./ek-computation/
COPY ek-db/ ./ek-db/
COPY ek-proto/ ./ek-proto/
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/app/target \
    cargo build --release --locked -p ek-cli \
    && cp /app/target/release/ek-cli /tmp/ek-cli

FROM rust-base AS ek-diesel-build

RUN --mount=type=cache,target=/root/.cargo/registry \
    cargo install diesel_cli --version 2.2.12 --locked \
    --no-default-features --features postgres

FROM ${RUNTIME_IMAGE} AS ek-runtime

# Replace official Debian APT sources with TUNA mirrors.
RUN sed -i \
        -e 's@//deb.debian.org@//mirrors.tuna.tsinghua.edu.cn@g' \
        -e 's@//security.debian.org@//mirrors.tuna.tsinghua.edu.cn@g' \
        /etc/apt/sources.list.d/debian.sources

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ek
COPY --from=ek-diesel-build /root/.cargo/bin/diesel /usr/local/bin/
COPY --from=ek-rust-build /tmp/ek-cli /usr/local/bin/

RUN mkdir -p /etc/expert-kit

ENTRYPOINT [""]

FROM ${UV_IMAGE} AS uv-bin

FROM ${RUNTIME_IMAGE} AS ek-worker-cuda-runtime

# Replace official Debian APT sources with TUNA mirrors.
RUN sed -i \
        -e 's@//deb.debian.org@//mirrors.tuna.tsinghua.edu.cn@g' \
        -e 's@//security.debian.org@//mirrors.tuna.tsinghua.edu.cn@g' \
        /etc/apt/sources.list.d/debian.sources

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libpq5 \
    python3.12 \
    python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv-bin /uv /uvx /usr/local/bin/
COPY --from=ek-rust-build /tmp/ek-cli /usr/local/bin/

WORKDIR /opt/expert-kit
COPY pyproject.toml uv.lock ./
COPY ek-proto/pyproject.toml ./ek-proto/pyproject.toml
COPY ek-transport/pyproject.toml ./ek-transport/pyproject.toml
COPY ek-worker/pyproject.toml ./ek-worker/pyproject.toml
COPY ek-integration/expertkit_torch/pyproject.toml \
    ./ek-integration/expertkit_torch/pyproject.toml
COPY ek-integration/expertkit_vllm/pyproject.toml \
    ./ek-integration/expertkit_vllm/pyproject.toml

ARG UV_HTTP_TIMEOUT=1800
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_HTTP_TIMEOUT=${UV_HTTP_TIMEOUT} \
    UV_LINK_MODE=copy \
    uv sync --locked --package expertkit-worker --no-dev --no-install-workspace

COPY ek-proto/ ./ek-proto/
COPY ek-transport/ ./ek-transport/
COPY ek-worker/ ./ek-worker/
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_HTTP_TIMEOUT=${UV_HTTP_TIMEOUT} \
    UV_LINK_MODE=copy \
    uv sync --locked --package expertkit-worker --no-dev

ENV PATH="/opt/expert-kit/.venv/bin:${PATH}"
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENTRYPOINT [""]

ARG ASCEND_IMAGE="quay.nju.edu.cn/ascend/vllm-ascend:v0.23.0rc1-a3"
ARG UV_IMAGE="ghcr.io/astral-sh/uv:0.11.30"

FROM ${ASCEND_IMAGE} AS ek-npu-probe

WORKDIR /opt/expert-kit
RUN python3 -c \
  "from importlib.metadata import version; \
   print('torch:', version('torch')); \
   print('torch-npu:', version('torch-npu'))"

FROM ${UV_IMAGE} AS uv-bin

FROM ek-npu-probe AS ek-worker-ascend-runtime

COPY pyproject.toml uv.lock ./
COPY ek-proto/ ek-proto/
COPY ek-transport/ ek-transport/
COPY ek-worker/ ek-worker/

COPY --from=uv-bin /uv /uvx /usr/local/bin/
